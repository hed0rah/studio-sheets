  "cards_title": "Rules for this room",
  "cards": [
    {"n": 1, "title": "Two mixes", "lines": [
      "The faders and MASTER build what goes to tape. The monitor section builds what you hear.",
      "A signal can be in one and not the other: that is how an overdub hears old tracks without recording them again."]},
    {"n": 2, "title": "Track through the desk", "lines": [
      "Listen on the desk's own phones while tracking: no latency, and it works with the computer off.",
      "The interface records the monitor mix for reference; mute that track while overdubbing or it loops."]},
    {"n": 3, "title": "The rack's mix out", "lines": [
      "Modular levels run hot, about 10 V peak to peak. Trim at the desk channel, not at the rack's mixer, so the rack patch stays as it was."]},
    {"n": 4, "title": "DC-coupled outs", "lines": [
      "Only DC-coupled interface outputs can send CV, gates or clock into the rack. Spend them on that, and keep audio on the others."]}
  ]
}
